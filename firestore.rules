rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "gig.ritik546@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Doctor Profile: Public read, Admin write
    match /doctor/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Clinic Profile: Public read, Admin write
    match /clinic/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Services: Public read, Admin write
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Treatments / Conditions: Public read, Admin write
    match /treatments/{treatmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews: Public read if approved, Admin full access
    match /reviews/{reviewId} {
      allow read: if resource.data.isApproved == true || isAdmin();
      allow write: if isAdmin();
    }

    // FAQs: Public read, Admin write
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Gallery: Public read, Admin write
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global Settings: Public read, Admin write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Appointments: Public can create with valid schema; ONLY Admin can list, read, update, delete
    match /appointments/{appointmentId} {
      allow create: if isValidId(appointmentId) &&
        incoming().patientName is string && incoming().patientName.size() >= 2 && incoming().patientName.size() <= 100 &&
        incoming().phone is string && incoming().phone.size() >= 8 && incoming().phone.size() <= 20 &&
        incoming().preferredDate is string && incoming().preferredDate.size() <= 30 &&
        incoming().status == "New";
      allow read, update, delete: if isAdmin();
    }

    // Inquiries: Public can create; ONLY Admin can list, read, update, delete
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) &&
        incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 100 &&
        incoming().phone is string && incoming().phone.size() >= 8 && incoming().phone.size() <= 20 &&
        incoming().status == "New";
      allow read, update, delete: if isAdmin();
    }

    // Admins collection: Only authenticated users can check their own admin status
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if isAdmin();
    }
  }
}
